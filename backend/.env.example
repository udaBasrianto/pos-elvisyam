# Security settings
# Comma-separated list of allowed CORS origins (required in production!)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:9001,http://localhost:5173

# Email for the super admin account (replaces hardcoded email)
# SUPER_ADMIN_EMAIL=superadmin@yourdomain.com
SUPER_ADMIN_EMAIL=

# Comma-separated extra upload directories to search (for multi-site setups)
# Example: EXTRA_UPLOAD_DIRS=/var/www/site1/uploads,/var/www/site2/uploads
EXTRA_UPLOAD_DIRS=

# DEV_MODE: enable dev-only seed accounts (NEVER enable in production!)
DEV_MODE=false
