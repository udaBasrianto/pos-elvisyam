PORT=5000
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pos_db
JWT_SECRET=your_jwt_secret_here
VITE_API_URL=/api

# Security: Comma-separated CORS allowed origins (required in production)
# Example: ALLOWED_ORIGINS=https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:9001,http://localhost:5173

# Super admin account email (replaces hardcoded email)
SUPER_ADMIN_EMAIL=

# DEV_MODE: enables auto-seed dev accounts (NEVER true in production!)
DEV_MODE=false

# Extra upload directories for multi-site deployments
EXTRA_UPLOAD_DIRS=
