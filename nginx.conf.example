# ------------------------------------------------------------------------------
# 5. BARBERSHOP & SALON POS (Subdomain: barber.domainanda.com)
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name barber.domainanda.com;

    root /var/www/posh/pos-barbershop/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }
}

# ------------------------------------------------------------------------------
# 6. SHARED BACKEND GO API (Subdomain: api.domainanda.com)
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name api.domainanda.com;

    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
