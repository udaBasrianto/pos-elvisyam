# ==============================================================================
# POSH MULTI-VERTICAL NGINX CONFIGURATION TEMPLATE
# ==============================================================================
# Ganti `domainanda.com` dengan domain utama Anda.
# Pastikan path `/var/www/posh` sesuai dengan direktori proyek di server Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RETAIL & GENERAL POS (Subdomain: retail.domainanda.com / pos.domainanda.com)
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name retail.domainanda.com pos.domainanda.com;

    root /var/www/posh/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }
}

# ------------------------------------------------------------------------------
# 2. RESTO & CAFE POS (Subdomain: resto.domainanda.com)
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name resto.domainanda.com;

    root /var/www/posh/pos-resto/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }
}

# ------------------------------------------------------------------------------
# 3. BENGKEL & OTOMOTIF POS (Subdomain: bengkel.domainanda.com)
# ------------------------------------------------------------------------------
