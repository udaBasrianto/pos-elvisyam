# ==============================================================================
# NGINX CONFIGURATION TEMPLATE: pos.elvisyam.com
# ==============================================================================
# Frontend SPA: /www/wwwroot/pos.elvisyam.com/dist
# Backend Go Proxy: 127.0.0.1:5001 (/api/)
# Uploads Dir: /www/wwwroot/pos.elvisyam.com/uploads/
# ==============================================================================

server {
    listen 80;
    server_name pos.elvisyam.com www.pos.elvisyam.com;

    root /www/wwwroot/pos.elvisyam.com/dist;
    index index.html;

    client_max_body_size 50M;

    # 1. Frontend SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 2. Proxy API ke Backend Go (Port 5001)
    location /api/ {
        proxy_pass http://127.0.0.1:5001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Timeout settings untuk transaksi besar / export data
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # 3. Static Files Uploads (Logo, Gambar Produk, Banner)
    location /uploads/ {
        alias /www/wwwroot/pos.elvisyam.com/uploads/;
        expires 30d;
        access_log off;
    }

    # 4. Static Asset Caching (JS, CSS, Icons, Fonts)
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, no-transform";
    }
}

