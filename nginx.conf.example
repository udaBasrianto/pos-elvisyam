# ------------------------------------------------------------------------------
# 4. LAUNDRY & CARWASH POS (Subdomain: laundry.domainanda.com)
# ------------------------------------------------------------------------------
server {
    listen 80;
    server_name laundry.domainanda.com;

    root /var/www/posh/pos-laundry/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
